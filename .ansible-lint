---
# Configuration ansible-lint du dépôt de formation
profile: production
exclude_paths:
  - .git/
  - 00-lab/keys/
  - tests/
  - 15-tests-qualite/demos/mauvais.yml
  - "**/vault.yml"
  - "**/collections/"
  - "**/labs/**/enonce/"
  - "**/molecule/"
warn_list:
  - experimental
skip_list:
  - yaml[line-length]
