---
# Configuration ansible-lint du dépôt de formation
profile: production
exclude_paths:
  - .git/
  - 00-lab/keys/
  - tests/
  - 18-awx-ee-eda/demos/awx-as-code/   # nécessite la collection awx.awx
  - 18-awx-ee-eda/demos/eda/rulebook.yml  # rulebook EDA, pas un playbook
  - 18-awx-ee-eda/demos/awx-install/
  - "**/execution-environment.yml"
  - "**/ansible-navigator.yml"
  - 15-tests-qualite/demos/mauvais.yml
  - "**/vault.yml"
  - "**/collections/"
  - "**/labs/**/enonce/"
  - "**/molecule/"
warn_list:
  - experimental
skip_list:
  - yaml[line-length]
